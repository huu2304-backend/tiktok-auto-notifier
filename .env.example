# ==========================================
# TikTok Beta US Automation Notifier Config
# ==========================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional: Nếu dùng Group Topics (forum channel)
TELEGRAM_MESSAGE_THREAD_ID=

# Google Sheets / Drive Sync Link (Tùy chọn: Dán link Google Sheets chia sẻ của bạn vào đây)
GOOGLE_SHEET_URL=

# Quét & Lọc Video
CHECK_INTERVAL_SECONDS=300
MIN_VIDEO_DURATION_SECONDS=0
FILTER_OUT_SHORTS=True
FILTER_OUT_LIVESTREAMS=True

# Cấu hình Mạng & Timeout
REQUEST_TIMEOUT=15
MAX_RETRIES=3

# Đường dẫn file tuỳ chỉnh (để trống nếu dùng mặc định)
CUSTOM_EXCEL_PATH=
CUSTOM_DB_PATH=
